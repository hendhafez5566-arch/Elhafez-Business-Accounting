NODE_ENV=production
PORT=3000
ELHAFEZ_BIND_HOST=127.0.0.1
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/elhafez

# PostgreSQL physical backup is platform-wide and Owner-Controlled.
ELHAFEZ_BACKUP_DIR=/var/lib/elhafez/backups
ELHAFEZ_RESTORE_MAINTENANCE_FILE=/var/lib/elhafez/backups/restore-maintenance.lock

# Restore is fail-closed. During an approved recovery window, point the restore URL
# at the SAME environment database, set both switches true, restart the API, enter
# maintenance from Owner Control, then run preflight and restore. Disable again after
# recovery verification and maintenance exit.
ELHAFEZ_RESTORE_DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/elhafez
ELHAFEZ_RESTORE_ENABLED=false
ELHAFEZ_ALLOW_IN_PLACE_RESTORE=false

# Optional when PostgreSQL binaries are not on PATH:
# ELHAFEZ_PG_DUMP=/usr/bin/pg_dump
# ELHAFEZ_PG_RESTORE=/usr/bin/pg_restore

# Keep empty for same-origin browser deployments behind the provided reverse proxy.
ELHAFEZ_CORS_ORIGINS=

# SAAS-01 security values must be supplied from the deployment secret store.
# See docs/SAAS-CONTROL-PLANE.md. Never commit real secrets.

SAAS_OWNER_RECOVERY_TOKEN=
