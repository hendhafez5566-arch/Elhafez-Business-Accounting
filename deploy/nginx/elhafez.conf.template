limit_req_zone $binary_remote_addr zone=elhafez_api:10m rate=20r/s;

upstream elhafez_api {
    server 127.0.0.1:3000;
    keepalive 32;
}

server {
    listen 80;
    server_name __TENANT_HOST__;
    return 301 https://$host$request_uri;
}
server {
    listen 80;
    server_name __OWNER_HOST__;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name __TENANT_HOST__;
    ssl_certificate __TENANT_CERT__;
    ssl_certificate_key __TENANT_KEY__;
    ssl_protocols TLSv1.2 TLSv1.3;
    server_tokens off;
    root /srv/elhafez/web;
    index index.html;
    client_max_body_size 25m;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "same-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    add_header Content-Security-Policy "default-src 'self'; connect-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; base-uri 'self'; frame-ancestors 'none'" always;

    location /api/ {
        limit_req zone=elhafez_api burst=60 nodelay;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_pass http://elhafez_api/;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}

server {
    listen 443 ssl http2;
    server_name __OWNER_HOST__;
    ssl_certificate __OWNER_CERT__;
    ssl_certificate_key __OWNER_KEY__;
    ssl_protocols TLSv1.2 TLSv1.3;
    server_tokens off;
    root /srv/elhafez/owner;
    index index.html;
    client_max_body_size 10m;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "same-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    add_header Content-Security-Policy "default-src 'self'; connect-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; base-uri 'self'; frame-ancestors 'none'" always;

    location /api/ {
        limit_req zone=elhafez_api burst=20 nodelay;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_pass http://elhafez_api/;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
