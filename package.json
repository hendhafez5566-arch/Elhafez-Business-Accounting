{
  "name": "elhafez-business-accounting",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "pnpm --recursive run build",
    "typecheck": "pnpm --recursive run typecheck",
    "lint": "eslint . --max-warnings=0",
    "architecture:check": "tsx tools/architecture/check-architecture.ts",
    "test": "pnpm --recursive run test",
    "prisma:generate": "pnpm --filter @elhafez/platform-core run prisma:generate",
    "verify": "pnpm change-safety:check && pnpm engineering-integrity:check && pnpm prisma:generate && pnpm lint && pnpm typecheck && pnpm architecture:check && pnpm test",
    "change-safety:check": "tsx tools/governance/check-change-safety.ts",
    "engineering-integrity:check": "tsx tools/governance/check-engineering-integrity.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@prisma/client": "6.19.0",
    "@types/node": "^22.13.4",
    "eslint": "^9.20.0",
    "eslint-plugin-import": "^2.31.0",
    "globals": "^15.15.0",
    "prisma": "6.19.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.0",
    "esbuild": "^0.28.2"
  }
}
