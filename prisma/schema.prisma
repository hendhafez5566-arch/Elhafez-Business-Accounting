generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model PcUser {
  id           String               @id @default(uuid()) @map("id")
  email        String               @unique
  passwordHash String               @map("password_hash")
  displayName  String               @map("display_name")
  status       String               @default("ACTIVE")
  createdAt    DateTime             @default(now()) @map("created_at")
  updatedAt    DateTime             @updatedAt @map("updated_at")
  sessions     PcSession[]
  userRoles    PcUserRole[]
  branchAccess PcUserBranchAccess[]

  @@map("pc_users")
}

model PcRole {
  id          String             @id @default(uuid())
  name        String             @unique
  createdAt   DateTime           @default(now()) @map("created_at")
  userRoles   PcUserRole[]
  permissions PcRolePermission[]

  @@map("pc_roles")
}

model PcPermission {
  id        String             @id @default(uuid())
  name      String             @unique
  createdAt DateTime           @default(now()) @map("created_at")
  roles     PcRolePermission[]

  @@map("pc_permissions")
}

model PcUserRole {
  userId String @map("user_id")
  roleId String @map("role_id")
  user   PcUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   PcRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("pc_user_roles")
}

model PcRolePermission {
  roleId       String       @map("role_id")
  permissionId String       @map("permission_id")
  role         PcRole       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   PcPermission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("pc_role_permissions")
}

model PcCompany {
  id        String     @id @default(uuid())
  name      String
  active    Boolean    @default(true)
  createdAt DateTime   @default(now()) @map("created_at")
  branches  PcBranch[]

  @@map("pc_companies")
}

model PcBranch {
  id        String               @id @default(uuid())
  companyId String               @map("company_id")
  name      String
  active    Boolean              @default(true)
  createdAt DateTime             @default(now()) @map("created_at")
  company   PcCompany            @relation(fields: [companyId], references: [id], onDelete: Restrict)
  access    PcUserBranchAccess[]

  @@unique([companyId, name])
  @@map("pc_branches")
}

model PcUserBranchAccess {
  userId   String   @map("user_id")
  branchId String   @map("branch_id")
  user     PcUser   @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch   PcBranch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@id([userId, branchId])
  @@map("pc_user_branch_access")
}

model PcSession {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      PcUser    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("pc_sessions")
}

model PcAuditLog {
  id         String   @id @default(uuid())
  actorId    String?  @map("actor_id")
  action     String
  resource   String
  entityId   String?  @map("entity_id")
  companyId  String?  @map("company_id")
  branchId   String?  @map("branch_id")
  metadata   Json     @default("{}")
  occurredAt DateTime @default(now()) @map("occurred_at")

  @@index([companyId, occurredAt])
  @@map("pc_audit_logs")
}

model PcFile {
  id          String   @id @default(uuid())
  companyId   String?  @map("company_id")
  storageKey  String   @unique @map("storage_key")
  contentType String   @map("content_type")
  size        Int
  createdBy   String?  @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("pc_files")
}

model PcNotification {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  type      String
  payload   Json      @default("{}")
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId, readAt])
  @@map("pc_notifications")
}

model PcConfiguration {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("pc_configuration")
}

model FxCurrency {
  companyId String  @map("company_id")
  code      String
  precision Int
  isBase    Boolean @default(false) @map("is_base")
  status    String  @default("ACTIVE")

  @@id([companyId, code])
  @@map("fx_currencies")
}

model FxRate {
  id           String   @id
  companyId    String   @map("company_id")
  fromCurrency String   @map("from_currency")
  toCurrency   String   @map("to_currency")
  effectiveAt  DateTime @map("effective_at")
  rate         Decimal  @db.Decimal(38, 18)
  source       String

  @@unique([companyId, fromCurrency, toCurrency, effectiveAt])
  @@index([companyId, fromCurrency, toCurrency, effectiveAt])
  @@map("fx_rates")
}

model CbaCostCenter {
  id                  String                 @id
  companyId           String                 @map("company_id")
  code                String
  name                String
  status              String                 @default("ACTIVE")
  parentId            String?                @map("parent_id")
  parent              CbaCostCenter?         @relation("CostCenterHierarchy", fields: [companyId, parentId], references: [companyId, id], onDelete: Restrict)
  children            CbaCostCenter[]        @relation("CostCenterHierarchy")
  programAssociations CbaProgramCostCenter[]

  @@unique([companyId, code])
  @@unique([companyId, id])
  @@index([companyId, status])
  @@map("cba_cost_centers")
}

model CbaProgramCostCenter {
  companyId    String        @map("company_id")
  sourceType   String        @map("source_type")
  sourceId     String        @map("source_id")
  costCenterId String        @map("cost_center_id")
  costCenter   CbaCostCenter @relation(fields: [companyId, costCenterId], references: [companyId, id], onDelete: Restrict)

  @@id([companyId, sourceType, sourceId])
  @@index([companyId, costCenterId])
  @@map("cba_program_cost_centers")
}
