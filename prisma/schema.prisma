generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model PcUser {
  id           String               @id @default(uuid()) @map("id")
  email        String               @unique
  passwordHash String               @map("password_hash")
  displayName  String               @map("display_name")
  status       String               @default("ACTIVE")
  createdAt    DateTime             @default(now()) @map("created_at")
  updatedAt    DateTime             @updatedAt @map("updated_at")
  sessions     PcSession[]
  userRoles    PcUserRole[]
  branchAccess PcUserBranchAccess[]

  @@map("pc_users")
}

model PcRole {
  id          String             @id @default(uuid())
  name        String             @unique
  createdAt   DateTime           @default(now()) @map("created_at")
  userRoles   PcUserRole[]
  permissions PcRolePermission[]

  @@map("pc_roles")
}

model PcPermission {
  id        String             @id @default(uuid())
  name      String             @unique
  createdAt DateTime           @default(now()) @map("created_at")
  roles     PcRolePermission[]

  @@map("pc_permissions")
}

model PcUserRole {
  userId String @map("user_id")
  roleId String @map("role_id")
  user   PcUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   PcRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("pc_user_roles")
}

model PcRolePermission {
  roleId       String       @map("role_id")
  permissionId String       @map("permission_id")
  role         PcRole       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   PcPermission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("pc_role_permissions")
}

model PcCompany {
  id        String     @id @default(uuid())
  name      String
  active    Boolean    @default(true)
  createdAt DateTime   @default(now()) @map("created_at")
  branches  PcBranch[]

  @@map("pc_companies")
}

model PcBranch {
  id        String               @id @default(uuid())
  companyId String               @map("company_id")
  name      String
  active    Boolean              @default(true)
  createdAt DateTime             @default(now()) @map("created_at")
  company   PcCompany            @relation(fields: [companyId], references: [id], onDelete: Restrict)
  access    PcUserBranchAccess[]

  @@unique([companyId, name])
  @@map("pc_branches")
}

model PcUserBranchAccess {
  userId   String   @map("user_id")
  branchId String   @map("branch_id")
  user     PcUser   @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch   PcBranch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@id([userId, branchId])
  @@map("pc_user_branch_access")
}

model PcSession {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      PcUser    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("pc_sessions")
}

model PcAuditLog {
  id         String   @id @default(uuid())
  actorId    String?  @map("actor_id")
  action     String
  resource   String
  entityId   String?  @map("entity_id")
  companyId  String?  @map("company_id")
  branchId   String?  @map("branch_id")
  metadata   Json     @default("{}")
  occurredAt DateTime @default(now()) @map("occurred_at")

  @@index([companyId, occurredAt])
  @@map("pc_audit_logs")
}

model PcFile {
  id          String   @id @default(uuid())
  companyId   String?  @map("company_id")
  storageKey  String   @unique @map("storage_key")
  contentType String   @map("content_type")
  size        Int
  createdBy   String?  @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("pc_files")
}

model PcNotification {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  type      String
  payload   Json      @default("{}")
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId, readAt])
  @@map("pc_notifications")
}

model PcConfiguration {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("pc_configuration")
}

/// AC-14A migration-control metadata only. Never accounting source truth.
model PcMigrationRun {
  id                   String    @id @default(uuid())
  sourceRepository     String    @map("source_repository")
  sourceCommit         String    @map("source_commit")
  sourceVersion        String    @map("source_version")
  sourceSha256         String?   @map("source_sha256")
  targetBaselineSha    String    @map("target_baseline_sha")
  implementationVersion String   @map("implementation_version")
  targetCompanyId      String    @map("target_company_id")
  actorId              String    @map("actor_id")
  mode                 String
  status               String    @default("PLANNED")
  configSnapshotHash   String    @map("config_snapshot_hash")
  processedCount       Int       @default(0) @map("processed_count")
  rejectedCount         Int       @default(0) @map("rejected_count")
  startedAt            DateTime? @map("started_at")
  completedAt          DateTime? @map("completed_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  crosswalks    PcMigrationCrosswalk[]
  checkpoints   PcMigrationCheckpoint[]
  issues        PcMigrationIssue[]
  equivalence   PcMigrationEquivalence[]

  @@map("pc_migration_runs")
}

model PcMigrationCrosswalk {
  id                String   @id @default(uuid())
  runId             String   @map("run_id")
  sourceCollection  String   @map("source_collection")
  sourceId          String   @map("source_id")
  targetOwner       String   @map("target_owner")
  targetKind        String   @map("target_kind")
  targetId          String   @map("target_id")
  sourcePayloadHash String   @map("source_payload_hash")
  createdAt         DateTime @default(now()) @map("created_at")

  run PcMigrationRun @relation(fields: [runId], references: [id])

  @@unique([runId, sourceCollection, sourceId, targetOwner, targetKind], name: "runId_sourceCollection_sourceId_targetOwner_targetKind", map: "pc_mig_xwalk_source_slot_key")
  @@unique([runId, targetOwner, targetKind, targetId], name: "runId_targetOwner_targetKind_targetId", map: "pc_mig_xwalk_target_key")
  @@map("pc_migration_crosswalks")
}

model PcMigrationCheckpoint {
  id             String   @id @default(uuid())
  runId          String   @map("run_id")
  stage          String
  cursor         String?
  processedCount Int      @default(0) @map("processed_count")
  status         String
  updatedAt      DateTime @updatedAt @map("updated_at")

  run PcMigrationRun @relation(fields: [runId], references: [id])

  @@unique([runId, stage], name: "runId_stage")
  @@map("pc_migration_checkpoints")
}

model PcMigrationIssue {
  id         String   @id @default(uuid())
  runId      String   @map("run_id")
  code       String
  stage      String?
  sourceCollection String? @map("source_collection")
  sourceId   String?  @map("source_id")
  detail     String?
  createdAt  DateTime @default(now()) @map("created_at")

  run PcMigrationRun @relation(fields: [runId], references: [id])

  @@map("pc_migration_issues")
}

model PcMigrationEquivalence {
  id            String   @id @default(uuid())
  runId         String   @map("run_id")
  checkKey      String   @map("check_key")
  /** Never null — an absent caller scope is normalized to "GLOBAL" before storage. */
  scope         String   @default("GLOBAL")
  expectedValue String   @map("expected_value")
  actualValue   String   @map("actual_value")
  status        String
  detail        String?
  checkedAt     DateTime @map("checked_at")

  run PcMigrationRun @relation(fields: [runId], references: [id])

  @@unique([runId, checkKey, scope], name: "runId_checkKey_scope")
  @@map("pc_migration_equivalence")
}

model FxCurrency {
  companyId String  @map("company_id")
  code      String
  precision Int
  isBase    Boolean @default(false) @map("is_base")
  status    String  @default("ACTIVE")

  @@id([companyId, code])
  @@map("fx_currencies")
}

model FxRate {
  id           String   @id
  companyId    String   @map("company_id")
  fromCurrency String   @map("from_currency")
  toCurrency   String   @map("to_currency")
  effectiveAt  DateTime @map("effective_at")
  rate         Decimal  @db.Decimal(38, 18)
  source       String

  @@unique([companyId, fromCurrency, toCurrency, effectiveAt])
  @@index([companyId, fromCurrency, toCurrency, effectiveAt])
  @@map("fx_rates")
}

model CbaCostCenter {
  id                  String                 @id
  companyId           String                 @map("company_id")
  code                String
  name                String
  status              String                 @default("ACTIVE")
  parentId            String?                @map("parent_id")
  parent              CbaCostCenter?         @relation("CostCenterHierarchy", fields: [companyId, parentId], references: [companyId, id], onDelete: Restrict)
  children            CbaCostCenter[]        @relation("CostCenterHierarchy")
  programAssociations CbaProgramCostCenter[]
  programAllocationEffects CbaProgramAllocationCostEffect[]
  tourismServiceActualizations CbaTourismServiceActualization[]

  @@unique([companyId, code])
  @@unique([companyId, id])
  @@index([companyId, status])
  @@map("cba_cost_centers")
}

model CbaProgramCostCenter {
  companyId    String        @map("company_id")
  sourceType   String        @map("source_type")
  sourceId     String        @map("source_id")
  costCenterId String        @map("cost_center_id")
  costCenter   CbaCostCenter @relation(fields: [companyId, costCenterId], references: [companyId, id], onDelete: Restrict)

  @@id([companyId, sourceType, sourceId])
  @@index([companyId, costCenterId])
  @@map("cba_program_cost_centers")
}

model PeriodFiscalYear {
  id           String                     @id
  companyId    String                     @map("company_id")
  startDate    DateTime                   @map("start_date") @db.Date
  endDate      DateTime                   @map("end_date") @db.Date
  status       String                     @default("OPEN")
  periods      PeriodAccountingPeriod[]
  closeHistory PeriodFiscalCloseHistory[]

  @@unique([companyId, id])
  @@index([companyId, startDate, endDate])
  @@map("period_fiscal_years")
}

model PeriodAccountingPeriod {
  id           String           @id
  companyId    String           @map("company_id")
  fiscalYearId String           @map("fiscal_year_id")
  startDate    DateTime         @map("start_date") @db.Date
  endDate      DateTime         @map("end_date") @db.Date
  status       String           @default("OPEN")
  fiscalYear   PeriodFiscalYear @relation(fields: [companyId, fiscalYearId], references: [companyId, id], onDelete: Restrict)

  @@unique([companyId, id])
  @@index([companyId, fiscalYearId, startDate, endDate])
  @@map("period_accounting_periods")
}

model PeriodFiscalCloseHistory {
  id                String           @id
  companyId         String           @map("company_id")
  fiscalYearId      String           @map("fiscal_year_id")
  closeJournalId    String           @map("close_journal_id")
  reversalJournalId String?          @map("reversal_journal_id")
  closedAt          DateTime         @map("closed_at")
  reopenedAt        DateTime?        @map("reopened_at")
  fiscalYear        PeriodFiscalYear @relation(fields: [companyId, fiscalYearId], references: [companyId, id], onDelete: Restrict)

  @@unique([companyId, fiscalYearId, closeJournalId])
  @@map("period_fiscal_close_history")
}

model GlAccount {
  id             String          @id
  companyId      String          @map("company_id")
  code           String
  name           String
  classification String
  active         Boolean         @default(true)
  postable       Boolean         @default(true)
  parentId       String?         @map("parent_id")
  controlType    String?         @map("control_type")
  parent         GlAccount?      @relation("GlAccountHierarchy", fields: [companyId, parentId], references: [companyId, id], onDelete: Restrict)
  children       GlAccount[]     @relation("GlAccountHierarchy")
  lines          GlJournalLine[]

  @@unique([companyId, id])
  @@unique([companyId, code])
  @@map("gl_accounts")
}

model GlJournal {
  id            String          @id
  companyId     String          @map("company_id")
  number        String
  postingDate   DateTime        @map("posting_date") @db.Date
  kind          String
  sourceType    String          @map("source_type")
  sourceId      String          @map("source_id")
  requestHash   String          @map("request_hash")
  correlationId String?         @map("correlation_id")
  reversalOfId  String?         @unique @map("reversal_of_id")
  fiscalYearId  String?         @map("fiscal_year_id")
  createdAt     DateTime        @default(now()) @map("created_at")
  reversalOf    GlJournal?      @relation("JournalReversal", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reversal      GlJournal?      @relation("JournalReversal")
  lines         GlJournalLine[]

  @@unique([companyId, number])
  @@unique([companyId, sourceType, sourceId])
  @@unique([companyId, id])
  @@index([companyId, postingDate])
  @@map("gl_journals")
}

model GlJournalLine {
  id              String    @id
  companyId       String    @map("company_id")
  journalId       String    @map("journal_id")
  accountId       String    @map("account_id")
  debit           Decimal?  @db.Decimal(38, 18)
  credit          Decimal?  @db.Decimal(38, 18)
  partyId         String?   @map("party_id")
  costCenterId    String?   @map("cost_center_id")
  foreignAmount   Decimal?  @map("foreign_amount") @db.Decimal(38, 18)
  foreignCurrency String?   @map("foreign_currency")
  fxRateId        String?   @map("fx_rate_id")
  fxRate          Decimal?  @map("fx_rate") @db.Decimal(38, 18)
  journal         GlJournal @relation(fields: [companyId, journalId], references: [companyId, id], onDelete: Restrict)
  account         GlAccount @relation(fields: [companyId, accountId], references: [companyId, id], onDelete: Restrict)

  @@index([companyId, journalId])
  @@index([companyId, accountId])
  @@index([companyId, costCenterId])
  @@map("gl_journal_lines")
}

model FcApprovalPolicy {
  id                 String              @id
  companyId          String              @map("company_id")
  action             String
  threshold          Decimal             @db.Decimal(38, 18)
  active             Boolean             @default(true)
  forbidSelfApproval Boolean             @map("forbid_self_approval")
  requiredAuthority  String              @map("required_authority")
  requests           FcApprovalRequest[]

  @@unique([companyId, action])
  @@unique([companyId, id])
  @@map("fc_approval_policies")
}

model FcApprovalRequest {
  id                               String              @id
  companyId                        String              @map("company_id")
  branchId                         String?             @map("branch_id")
  action                           String
  sourceType                       String              @map("source_type")
  sourceId                         String              @map("source_id")
  requesterActorId                 String              @map("requester_actor_id")
  amount                           Decimal             @db.Decimal(38, 18)
  status                           String              @default("PENDING")
  policyId                         String              @map("policy_id")
  policyThresholdSnapshot          Decimal             @map("policy_threshold_snapshot") @db.Decimal(38, 18)
  policyForbidSelfApprovalSnapshot Boolean             @map("policy_forbid_self_approval_snapshot")
  policyRequiredAuthoritySnapshot  String              @map("policy_required_authority_snapshot")
  requestedAt                      DateTime            @map("requested_at")
  policy                           FcApprovalPolicy    @relation(fields: [companyId, policyId], references: [companyId, id], onDelete: Restrict)
  decision                         FcApprovalDecision?

  @@unique([companyId, sourceType, sourceId])
  @@unique([companyId, id])
  @@map("fc_approval_requests")
}

model FcApprovalDecision {
  id        String            @id
  requestId String            @unique @map("request_id")
  companyId String            @map("company_id")
  outcome   String
  actorId   String            @map("actor_id")
  reason    String?
  decidedAt DateTime          @map("decided_at")
  request   FcApprovalRequest @relation(fields: [companyId, requestId], references: [companyId, id], onDelete: Restrict)

  @@unique([companyId, requestId])
  @@map("fc_approval_decisions")
}

model FcReconciliationRun {
  id            String                  @id
  companyId     String                  @map("company_id")
  branchId      String?                 @map("branch_id")
  type          String
  correlationId String                  @map("correlation_id")
  fingerprint   String
  clean         Boolean
  runAt         DateTime                @map("run_at")
  issues        FcReconciliationIssue[]

  @@unique([companyId, correlationId])
  @@unique([companyId, id])
  @@map("fc_reconciliation_runs")
}

model FcReconciliationIssue {
  id                  String              @id
  companyId           String              @map("company_id")
  runId               String              @map("run_id")
  evidenceKey         String              @map("evidence_key")
  sourceAmount        Decimal             @map("source_amount") @db.Decimal(38, 18)
  ledgerAmount        Decimal             @map("ledger_amount") @db.Decimal(38, 18)
  difference          Decimal             @db.Decimal(38, 18)
  detail              String
  resolvedAt          DateTime?           @map("resolved_at")
  resolutionReference String?             @map("resolution_reference")
  run                 FcReconciliationRun @relation(fields: [companyId, runId], references: [companyId, id], onDelete: Restrict)

  @@unique([runId, evidenceKey])
  @@index([companyId, resolvedAt])
  @@map("fc_reconciliation_issues")
}

model FcCloseReadinessRun {
  id            String   @id
  companyId     String   @map("company_id")
  branchId      String?  @map("branch_id")
  correlationId String   @map("correlation_id")
  fingerprint   String
  ready         Boolean
  blockers      Json
  warnings      Json
  evaluatedAt   DateTime @map("evaluated_at")

  @@unique([companyId, correlationId])
  @@map("fc_close_readiness_runs")
}

model FcControlEvidence {
  id         String   @id
  companyId  String   @map("company_id")
  kind       String
  subjectId  String   @map("subject_id")
  detail     Json
  occurredAt DateTime @map("occurred_at")

  @@index([companyId, kind, occurredAt])
  @@map("fc_control_evidence")
}

model TaxPolicy {
  id              String   @id
  companyId       String   @map("company_id")
  code            String
  effectiveFrom   DateTime @map("effective_from") @db.Date
  rate            Decimal  @db.Decimal(38, 18)
  outputAccountId String   @map("output_account_id")
  inputAccountId  String   @map("input_account_id")

  @@unique([companyId, id])
  @@unique([companyId, code, effectiveFrom])
  @@map("tax_policies")
}

model TaxSnapshot {
  id              String   @id
  companyId       String   @map("company_id")
  policyId        String   @map("policy_id")
  code            String
  effectiveAt     DateTime @map("effective_at")
  rate            Decimal  @db.Decimal(38, 18)
  taxableAmount   Decimal  @map("taxable_amount") @db.Decimal(38, 18)
  taxAmount       Decimal  @map("tax_amount") @db.Decimal(38, 18)
  outputAccountId String   @map("output_account_id")
  inputAccountId  String   @map("input_account_id")
  createdAt       DateTime @default(now()) @map("created_at")

  @@unique([companyId, id])
  @@map("tax_snapshots")
}

model BillingInvoice {
  id                    String               @id
  companyId             String               @map("company_id")
  branchId              String?              @map("branch_id")
  type                  String
  status                String
  partyId               String               @map("party_id")
  number                String
  externalInvoiceNumber String?              @map("external_invoice_number")
  postingDate           DateTime             @map("posting_date") @db.Date
  dueDate               DateTime?            @map("due_date") @db.Date
  currency              String
  fxRateId              String?              @map("fx_rate_id")
  sourceType            String               @map("source_type")
  sourceId              String               @map("source_id")
  requestHash           String               @map("request_hash")
  controlAccountId      String               @map("control_account_id")
  baseTotal             Decimal              @map("base_total") @db.Decimal(38, 18)
  outstanding           Decimal              @db.Decimal(38, 18)
  journalId             String?              @map("journal_id")
  reversalJournalId     String?              @map("reversal_journal_id")
  recognitionReference  String?              @map("recognition_reference")
  deferred              Boolean              @default(false)
  createdAt             DateTime             @default(now()) @map("created_at")
  lines                 BillingInvoiceLine[]

  @@unique([companyId, id])
  @@unique([companyId, sourceType, sourceId])
  @@index([companyId, partyId, externalInvoiceNumber])
  @@index([companyId, partyId, status])
  @@map("billing_invoices")
}

model BillingInvoiceLine {
  id            String         @id
  companyId     String         @map("company_id")
  invoiceId     String         @map("invoice_id")
  accountId     String         @map("account_id")
  amount        Decimal        @db.Decimal(38, 18)
  taxCode       String?        @map("tax_code")
  taxSnapshotId String?        @map("tax_snapshot_id")
  taxAmount     Decimal?       @map("tax_amount") @db.Decimal(38, 18)
  taxAccountId  String?        @map("tax_account_id")
  invoice       BillingInvoice @relation(fields: [companyId, invoiceId], references: [companyId, id], onDelete: Restrict)

  @@unique([companyId, id])
  @@index([companyId, invoiceId])
  @@map("billing_invoice_lines")
}

model BillingCreditLimit {
  companyId String  @map("company_id")
  partyId   String  @map("party_id")
  amount    Decimal @db.Decimal(38, 18)

  @@id([companyId, partyId])
  @@map("billing_credit_limits")
}

model BillingAllocation {
  id                    String    @id
  companyId             String    @map("company_id")
  partyKind             String    @map("party_kind")
  partyId               String    @map("party_id")
  invoiceId             String?   @map("invoice_id")
  amount                Decimal   @db.Decimal(38, 18)
  appliedAmount         Decimal   @map("applied_amount") @db.Decimal(38, 18)
  advanceAmount         Decimal   @map("advance_amount") @db.Decimal(38, 18)
  sourceType            String    @map("source_type")
  sourceId              String    @map("source_id")
  settlementId          String?   @map("settlement_id")
  settlementSequence    Int?      @map("settlement_sequence")
  carryingBaseAmount    Decimal?  @map("carrying_base_amount") @db.Decimal(38, 18)
  settlementBaseAmount  Decimal?  @map("settlement_base_amount") @db.Decimal(38, 18)
  realizedFx            Decimal?  @map("realized_fx") @db.Decimal(38, 18)
  settlementFxRateId    String?   @map("settlement_fx_rate_id")
  prefundingBaseAmount   Decimal?  @map("prefunding_base_amount") @db.Decimal(38, 18)
  prefundingAccountId    String?   @map("prefunding_account_id")
  reclassificationJournalId String? @map("reclassification_journal_id")
  reclassificationReversalJournalId String? @map("reclassification_reversal_journal_id")
  restrictionSourceType String?   @map("restriction_source_type")
  restrictionSourceId   String?   @map("restriction_source_id")
  requestHash           String    @map("request_hash")
  reversedAt            DateTime? @map("reversed_at")

  @@unique([companyId, id])
  @@unique([companyId, sourceType, sourceId])
  @@unique([companyId, settlementId, settlementSequence])
  @@index([companyId, invoiceId])
  @@map("billing_allocations")
}

model BillingAdvance {
  id                      String    @id
  companyId               String    @map("company_id")
  partyKind               String    @map("party_kind")
  partyId                 String    @map("party_id")
  amount                  Decimal   @db.Decimal(38, 18)
  available               Decimal   @db.Decimal(38, 18)
  sourceType              String    @map("source_type")
  sourceId                String    @map("source_id")
  restrictionSourceType   String?   @map("restriction_source_type")
  restrictionSourceId     String?   @map("restriction_source_id")
  generatedByAdjustmentId String?   @map("generated_by_adjustment_id")
  reversedAt              DateTime? @map("reversed_at")

  @@unique([companyId, id])
  @@index([companyId, partyKind, partyId])
  @@map("billing_advances")
}

model BillingAdvanceConsumption {
  id         String    @id
  companyId  String    @map("company_id")
  advanceId  String    @map("advance_id")
  amount     Decimal   @db.Decimal(38, 18)
  sourceType String    @map("source_type")
  sourceId   String    @map("source_id")
  reversedAt DateTime? @map("reversed_at")

  @@unique([companyId, id])
  @@unique([companyId, sourceType, sourceId])
  @@map("billing_advance_consumptions")
}

model BillingAdjustment {
  id            String    @id
  companyId     String    @map("company_id")
